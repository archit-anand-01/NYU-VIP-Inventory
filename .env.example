# Copy to .env.local for local development, and set the same keys in your
# hosting provider (Vercel: Project Settings -> Environment Variables).

# Signs the faculty session cookie. Any random string of 32+ characters.
# Generate one with:  openssl rand -base64 32
SESSION_SECRET=

# The single shared password professors and administrators type at /login.
FACULTY_PASSWORD=

# Leave both blank to use the local .data/ JSON file instead of Supabase.
# Project Settings -> API in the Supabase dashboard.
SUPABASE_URL=
# The service_role key. Server-side only - it bypasses Row Level Security,
# so it must never be committed or exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=
